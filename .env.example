# Optional OpenAI-compatible backend. Without these values the server remains
# usable, but unknown questions are returned as needs_review instead of guessed.
# NVIDIA NIM example: https://integrate.api.nvidia.com/v1
QUAESTIO_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
QUAESTIO_LLM_API_KEY=
QUAESTIO_LLM_MODEL=stepfun-ai/step-3.7-flash
QUAESTIO_LLM_TIMEOUT_SECONDS=60
QUAESTIO_LLM_MAX_TOKENS=2048

# Optional independent second backend. When all three are set, Quaestio only
# returns a proposal from the LLM path when both backends agree.
QUAESTIO_SECONDARY_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
QUAESTIO_SECONDARY_LLM_API_KEY=
QUAESTIO_SECONDARY_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
QUAESTIO_SECONDARY_LLM_TIMEOUT_SECONDS=60
QUAESTIO_SECONDARY_LLM_MAX_TOKENS=4096

# Optional language preparation. Non-English questions are translated once
# into a shared English working representation before both multimodal solvers
# receive them. The original image is never translated.
QUAESTIO_TRANSLATION_MODE=auto
QUAESTIO_TRANSLATION_TARGET_LANGUAGE=en
QUAESTIO_TRANSLATOR_BASE_URL=https://integrate.api.nvidia.com/v1
QUAESTIO_TRANSLATOR_API_KEY=
QUAESTIO_TRANSLATOR_MODEL=stepfun-ai/step-3.7-flash
QUAESTIO_TRANSLATOR_TIMEOUT_SECONDS=30
QUAESTIO_TRANSLATOR_MAX_TOKENS=2048
QUAESTIO_TRANSLATION_OCR=auto
QUAESTIO_TRANSLATION_OCR_LANGUAGE=por+eng

# Optional persistent local knowledge-base index.
QUAESTIO_KNOWLEDGE_BASE_PATH=./data/knowledge.json

# Optional semantic retrieval. If absent or unavailable, TF-IDF remains active.
QUAESTIO_EMBEDDING_BASE_URL=
QUAESTIO_EMBEDDING_API_KEY=
QUAESTIO_EMBEDDING_MODEL=
QUAESTIO_EMBEDDING_TIMEOUT_SECONDS=30

# Optional explicit Tesseract executable path. OCR also accepts the `tesseract`
# executable found on PATH and never writes the submitted image to disk.
QUAESTIO_TESSERACT_PATH=

# Optional Docker sandbox configuration. The image must already exist locally;
# Quaestio never pulls images automatically.
QUAESTIO_DOCKER_PATH=
QUAESTIO_SANDBOX_PYTHON_IMAGE=python:3.12-slim

# Optional independent semantic verifier. Keep it separate from the solver
# backend when you need a second model/provider to review answers.
QUAESTIO_VERIFIER_LLM_BASE_URL=
QUAESTIO_VERIFIER_LLM_API_KEY=
QUAESTIO_VERIFIER_LLM_MODEL=openai/gpt-oss-20b
QUAESTIO_VERIFIER_LLM_TIMEOUT_SECONDS=45
QUAESTIO_VERIFIER_LLM_MAX_TOKENS=2048
QUAESTIO_VERIFIER_LLM_SUPPORTS_IMAGES=false

# Smoke-test-only safety limit. This is read by `quaestio-smoke` and is not
# applied by the MCP server or by provider clients during normal operation.
QUAESTIO_SMOKE_REQUESTS_PER_MINUTE=40

# Optional: enables deterministic symbolic math verification.
# Install with: pip install -e ".[math]"
